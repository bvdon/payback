{
  "name": "payback",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "browser": "node scripts/build.mjs && cargo run --release -p payback-devserver -- --data ./payback-dev.json --dist ./dist",
    "test:core": "cargo test",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0"
  }
}
